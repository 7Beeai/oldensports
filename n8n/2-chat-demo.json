{
  "name": "Olden | 2. Chat de demonstração",
  "nodes": [
    {
      "id": "b2000000-0000-4000-8000-000000000101",
      "name": "Chat público",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "webhookId": "c3d2e1f0-4a5b-4c6d-8e7f-0a1b2c3d4e5f",
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "authentication": "none",
        "initialMessages": "Oi! Eu sou a Lia, da Olden Sports 💚\nBora achar o manto do Verdão pra você? 🟢⚽",
        "options": {
          "title": "Olden Sports",
          "subtitle": "Atendimento virtual (ambiente de demonstração)",
          "inputPlaceholder": "Digite sua mensagem...",
          "customCss": ":root {\n  --chat--color--primary: #0b6b3a;\n  --chat--color--primary-shade-50: #095a31;\n  --chat--color--primary--shade-100: #074a28;\n  --chat--color--secondary: #0b6b3a;\n  --chat--color-secondary-shade-50: #095a31;\n  --chat--header--background: #0b6b3a;\n}"
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000102",
      "name": "Preparar mensagem",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "p-0",
              "name": "sessao",
              "type": "string",
              "value": "={{ 'demo:' + $json.sessionId }}"
            },
            {
              "id": "p-1",
              "name": "mensagem",
              "type": "string",
              "value": "={{ $json.chatInput }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000103",
      "name": "Chamar núcleo do agente",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Chat público": {
      "main": [
        [
          {
            "node": "Preparar mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar mensagem": {
      "main": [
        [
          {
            "node": "Chamar núcleo do agente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 300
  }
