{
  "name": "Olden | 2. Chat de demonstração",
  "nodes": [
    {
      "id": "b2000000-0000-4000-8000-000000000101",
      "name": "Chat público",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "webhookId": "c3d2e1f0-4a5b-4c6d-8e7f-0a1b2c3d4e5f",
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "authentication": "none",
        "initialMessages": "Oi! Aqui é a Lia, da Olden Sports 😊\nO que você está procurando hoje?",
        "options": {
          "title": "Olden Sports",
          "subtitle": "Atendimento (ambiente de demonstração)",
          "inputPlaceholder": "Digite sua mensagem...",
          "customCss": ":root {\n  --chat--color--primary: #0b6b3a;\n  --chat--color--primary-shade-50: #095a31;\n  --chat--color--primary--shade-100: #074a28;\n  --chat--color--secondary: #0b6b3a;\n  --chat--color-secondary-shade-50: #095a31;\n  --chat--header--background: #0b6b3a;\n}"
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000102",
      "name": "Preparar mensagem",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "p-0",
              "name": "sessao",
              "type": "string",
              "value": "={{ 'demo:' + $json.sessionId }}"
            },
            {
              "id": "p-1",
              "name": "mensagem",
              "type": "string",
              "value": "={{ $json.chatInput }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000103",
      "name": "Chamar núcleo do agente",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000104",
      "name": "Página do chat",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        260
      ],
      "webhookId": "a7b8c9d0-4e5f-4a6b-9c23-d4e5f6a7b8c9",
      "parameters": {
        "httpMethod": "GET",
        "path": "olden-chat",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000105",
      "name": "Responder página",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        240,
        260
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"robots\" content=\"noindex\">\n<title>Olden Sports</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{height:100%;margin:0}\nbody{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#e9efe9;color:#14231b;display:flex;flex-direction:column}\nheader{background:#0b6b3a;color:#fff;padding:12px 16px;display:flex;align-items:center;gap:12px}\n.avatar{width:40px;height:40px;border-radius:50%;background:#fff;color:#0b6b3a;display:flex;align-items:center;justify-content:center;font-weight:700}\nheader h1{font-size:17px;margin:0}header p{font-size:13px;margin:2px 0 0;opacity:.85}\nheader button{margin-left:auto;background:transparent;border:1px solid rgba(255,255,255,.6);color:#fff;border-radius:8px;padding:6px 10px;font-size:13px;cursor:pointer}\n.aviso{background:#fff4d6;color:#6b4e00;font-size:12px;padding:6px 16px;text-align:center}\n#msgs{flex:1;overflow-y:auto;padding:12px 12px 4px;display:flex;flex-direction:column;gap:6px}\n.m{max-width:82%;padding:8px 12px;border-radius:12px;line-height:1.4;font-size:15px;word-wrap:break-word;box-shadow:0 1px 1px rgba(0,0,0,.08)}\n.lia{background:#fff;align-self:flex-start;border-top-left-radius:4px}\n.eu{background:#d4f5d0;align-self:flex-end;border-top-right-radius:4px}\n.m img{max-width:100%;border-radius:8px;margin:6px 0;display:block}\n.m a{color:#0b6b3a;word-break:break-all}\n.bloco{align-self:flex-start;max-width:92%;width:100%}\n.acoes{display:flex;flex-direction:column;gap:4px;margin-top:4px;max-width:82%}\n.acao{background:#fff;color:#0b6b3a;border:1px solid #cfe3d6;border-radius:10px;padding:8px 10px;font-size:14px;font-weight:600;cursor:pointer;text-align:center}\n.acao:hover{background:#f1f8f3}\n.menu{background:#fff;border-radius:12px;box-shadow:0 1px 1px rgba(0,0,0,.08);max-width:82%;overflow:hidden}\n.menu .corpo{padding:8px 12px;font-size:15px}\n.menu .opcao{display:block;width:100%;text-align:left;border:0;border-top:1px solid #eef1ef;background:#fff;padding:9px 12px;cursor:pointer;font-size:14px}\n.menu .opcao b{display:block;color:#14231b}.menu .opcao span{color:#5b6b62;font-size:12.5px}\n.menu .opcao:hover{background:#f1f8f3}\n.trilho{display:flex;gap:8px;overflow-x:auto;padding:2px 2px 8px;scroll-snap-type:x mandatory}\n.card{flex:0 0 172px;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,.1);scroll-snap-align:start;display:flex;flex-direction:column}\n.card img{width:100%;aspect-ratio:1/1;object-fit:cover;background:#f3f5f4;display:block}\n.card .info{padding:8px 10px;display:flex;flex-direction:column;gap:2px;flex:1}\n.card .nome{font-size:13.5px;font-weight:600;line-height:1.25;max-height:2.5em;overflow:hidden}\n.card .preco{font-size:14px;font-weight:700}\n.card .de{font-size:12px;color:#8a958f;text-decoration:line-through;margin-right:4px;font-weight:400}\n.card .pix{font-size:12px;color:#0b6b3a}\n.card .tam{font-size:11.5px;color:#5b6b62}\n.card button{margin:6px 10px 10px;border:0;border-radius:8px;background:#0b6b3a;color:#fff;padding:7px;font-size:13px;font-weight:600;cursor:pointer}\n.card.grande{flex:0 0 auto;width:min(300px,100%)}\n.legenda{font-size:15px;background:#fff;border-radius:12px;padding:8px 12px;margin-bottom:6px;display:inline-block;box-shadow:0 1px 1px rgba(0,0,0,.08)}\n.secao{font-size:13px;font-weight:700;color:#0b6b3a;margin:6px 2px 4px}\n.galeria{display:flex;gap:6px;overflow-x:auto}\n.galeria img{height:180px;border-radius:10px}\n.form{background:#fff;border-radius:12px;padding:10px 12px;box-shadow:0 1px 1px rgba(0,0,0,.08);max-width:300px}\n.form .t{font-size:15px;margin-bottom:8px}.form label{display:block;font-size:12.5px;color:#5b6b62;margin:6px 0 2px}\n.form input{width:100%;font-size:15px;padding:8px 10px;border-radius:8px}\n.chips{display:flex;gap:6px;margin-top:4px}.chip{flex:1;border:1px solid #cfe3d6;background:#fff;border-radius:8px;padding:7px 4px;font-size:13px;cursor:pointer}\n.chip.on{background:#0b6b3a;color:#fff;border-color:#0b6b3a}\n.form .enviar{width:100%;margin-top:10px;border:0;border-radius:8px;background:#0b6b3a;color:#fff;padding:9px;font-weight:700;cursor:pointer}\n.comp{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,.1);max-width:360px}\n.comp .cols{display:grid;grid-template-columns:1fr 1fr}\n.comp .col{padding:8px;border-right:1px solid #eef1ef}.comp .col:last-child{border-right:0}\n.comp img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:8px;background:#f3f5f4}\n.comp .nome{font-size:13px;font-weight:700;margin:6px 0 2px;line-height:1.25}\n.comp .lin{font-size:12px;color:#33433a;border-top:1px solid #f0f3f1;padding:4px 0}\n.comp .lin b{display:block;color:#5b6b62;font-weight:600;font-size:11px;text-transform:uppercase}\n.pagar{display:inline-block;background:#0b6b3a;color:#fff !important;text-decoration:none;border-radius:10px;padding:10px 14px;font-weight:700;margin-top:6px}\n.digitando{font-size:13px;color:#5b6b62;padding:0 16px 6px;min-height:20px}\nform{display:flex;gap:8px;padding:8px;background:#f3f5f4;border-top:1px solid #dde4df}\ninput{flex:1;border:1px solid #cfd8d3;border-radius:20px;padding:10px 14px;font-size:16px;outline:none}\nform button{background:#0b6b3a;color:#fff;border:0;border-radius:20px;padding:0 18px;font-size:15px;font-weight:600;cursor:pointer}\nform button:disabled{opacity:.5}\n</style>\n</head>\n<body>\n<header>\n  <div class=\"avatar\">L</div>\n  <div><h1>Lia · Olden Sports</h1><p>Atendimento</p></div>\n  <button id=\"nova\" type=\"button\">Nova conversa</button>\n</header>\n<div class=\"aviso\">Ambiente de demonstração</div>\n<div id=\"msgs\"></div>\n<div class=\"digitando\" id=\"digitando\"></div>\n<form id=\"f\"><input id=\"t\" autocomplete=\"off\" placeholder=\"Digite sua mensagem...\"><button id=\"b\">Enviar</button></form>\n<script>\n(function () {\n  var BOAS_VINDAS = 'Oi! Aqui é a Lia, da Olden Sports 😊\\nO que você está procurando hoje?';\n  var guardar = {\n    ler: function (k, padrao) { try { var v = localStorage.getItem(k); return v === null ? padrao : JSON.parse(v); } catch (e) { return padrao; } },\n    gravar: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }\n  };\n  function novoId() { return (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2)).replace(/[^a-zA-Z0-9-]/g, ''); }\n  var estado = guardar.ler('olden_chat', null);\n  if (!estado || !estado.sessao) estado = { sessao: novoId(), ultimo: 0, msgs: [{ de: 'lia', texto: BOAS_VINDAS }] };\n  var caixa = document.getElementById('msgs'), digitando = document.getElementById('digitando');\n  var form = document.getElementById('f'), input = document.getElementById('t'), botao = document.getElementById('b');\n\n  function esc(s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]; }); }\n  function formatar(texto) {\n    var h = esc(texto);\n    h = h.replace(/!\\[([^\\]]*)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g, '<img alt=\"$1\" src=\"$2\">');\n    h = h.replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g, '<a href=\"$2\" target=\"_blank\" rel=\"noopener\">$1</a>');\n    h = h.replace(/(^|[\\s(])(https?:\\/\\/[^\\s<)]+)/g, '$1<a href=\"$2\" target=\"_blank\" rel=\"noopener\">$2</a>');\n    h = h.replace(/\\*\\*([^*]+)\\*\\*/g, '<b>$1</b>');\n    return h.replace(/\\n/g, '<br>');\n  }\n  function brl(v) { return v == null ? '' : 'R$ ' + Number(v).toFixed(2).replace('.', ','); }\n  function urlSegura(u) { return /^https?:\\/\\//.test(String(u || '')) ? String(u) : ''; }\n\n  function el(tag, cls, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; }\n  function rolar() { caixa.scrollTop = caixa.scrollHeight; }\n\n  function cartao(p, grande, comPreco) {\n    var c = el('div', 'card' + (grande ? ' grande' : ''));\n    var img = urlSegura(p.imagem);\n    c.innerHTML = (img ? '<img loading=\"lazy\" alt=\"' + esc(p.nome) + '\" src=\"' + esc(img) + '\">' : '') +\n      '<div class=\"info\"><div class=\"nome\">' + esc(p.nome) + '</div>' +\n      (comPreco ? '<div class=\"preco\">' + (p.preco_original && p.preco_original > p.preco ? '<span class=\"de\">' + brl(p.preco_original) + '</span>' : '') + brl(p.preco) + ' no cartão</div>' +\n      (p.preco_pix && p.preco_pix < p.preco ? '<div class=\"pix\">✨ Condição especial no Pix: ' + brl(p.preco_pix) + '</div>' : '') : '') +\n      (p.tamanhos && p.tamanhos.length ? '<div class=\"tam\">Tam.: ' + esc(p.tamanhos.join(', ')) + '</div>' : '') + '</div>';\n    var b = el('button', null, 'Quero esse');\n    b.type = 'button';\n    b.onclick = function () { enviar('Quero o ' + p.nome); };\n    c.appendChild(b);\n    return c;\n  }\n  function botoesAcao(lista, aoTocar) {\n    var wrap = el('div', 'acoes');\n    lista.forEach(function (x) { var b = el('button', 'acao', esc(x.titulo)); b.type = 'button'; b.onclick = function () { aoTocar(x); }; wrap.appendChild(b); });\n    return wrap;\n  }\n\n  function desenharBloco(b) {\n    var box = el('div', 'bloco');\n    if (b.tipo === 'texto') {\n      var m = el('div', 'm lia', formatar(b.texto)); box.appendChild(m);\n      if (b.botoes && b.botoes.length) box.appendChild(botoesAcao(b.botoes, function (x) { enviar(x.titulo); }));\n    } else if (b.tipo === 'menu') {\n      var menu = el('div', 'menu');\n      menu.appendChild(el('div', 'corpo', formatar(b.corpo)));\n      (b.opcoes || []).forEach(function (o) {\n        var op = el('button', 'opcao', '<b>' + esc(o.titulo) + '</b>' + (o.descricao ? '<span>' + esc(o.descricao) + '</span>' : ''));\n        op.type = 'button'; op.onclick = function () { enviar(o.titulo); }; menu.appendChild(op);\n      });\n      box.appendChild(menu);\n    } else if (b.tipo === 'produto') {\n      if (b.texto) box.appendChild(el('div', 'legenda', formatar(b.texto)));\n      var t1 = el('div', 'trilho'); t1.appendChild(cartao(b.produto, true, b.mostrar_preco)); box.appendChild(t1);\n      box.appendChild(botoesAcao([{ titulo: 'Ver mais fotos' }], function () { enviar('Quero ver mais fotos do ' + b.produto.nome); }));\n    } else if (b.tipo === 'carrossel_produtos') {\n      if (b.corpo) box.appendChild(el('div', 'legenda', formatar(b.corpo)));\n      var t2 = el('div', 'trilho'); (b.produtos || []).forEach(function (p) { t2.appendChild(cartao(p, false, b.mostrar_preco)); }); box.appendChild(t2);\n    } else if (b.tipo === 'vitrine') {\n      box.appendChild(el('div', 'legenda', '<b>' + esc(b.cabecalho) + '</b>' + (b.corpo ? '<br>' + formatar(b.corpo) : '')));\n      (b.secoes || []).forEach(function (s) {\n        box.appendChild(el('div', 'secao', esc(s.titulo)));\n        var t3 = el('div', 'trilho'); (s.produtos || []).forEach(function (p) { t3.appendChild(cartao(p, false, b.mostrar_preco)); }); box.appendChild(t3);\n      });\n    } else if (b.tipo === 'midias') {\n      if (b.texto) box.appendChild(el('div', 'legenda', formatar(b.texto)));\n      var g = el('div', 'galeria');\n      (b.produto.imagens || []).forEach(function (i) { var u = urlSegura(i.url); if (u) g.appendChild(el('img', null)).src = u; });\n      box.appendChild(g);\n      var v = urlSegura(b.produto.video);\n      if (v) box.appendChild(el('div', 'm lia', '<a href=\"' + esc(v) + '\" target=\"_blank\" rel=\"noopener\">▶ Ver vídeo</a>'));\n    } else if (b.tipo === 'tamanho') {\n      var f = el('div', 'form'); var p0 = b.produto || {}; var crianca = p0.faixa_etaria === 'infantil' || p0.faixa_etaria === 'bebe';\n      f.appendChild(el('div', 't', formatar(b.texto)));\n      if (crianca) {\n        f.appendChild(el('label', null, 'Idade da criança (anos)'));\n        var idade = el('input'); idade.type = 'number'; idade.min = 0; idade.max = 16; idade.placeholder = 'ex.: 6'; f.appendChild(idade);\n      } else {\n        f.appendChild(el('label', null, 'Altura (cm)'));\n        var alt = el('input'); alt.type = 'number'; alt.placeholder = 'ex.: 172'; f.appendChild(alt);\n        f.appendChild(el('label', null, 'Peso (kg)'));\n        var peso = el('input'); peso.type = 'number'; peso.placeholder = 'ex.: 70'; f.appendChild(peso);\n        f.appendChild(el('label', null, 'Como você gosta que a camisa fique?'));\n        var chips = el('div', 'chips'); var caimento = 'normal';\n        ['justa', 'normal', 'solta'].forEach(function (c) {\n          var ch = el('button', 'chip' + (c === 'normal' ? ' on' : ''), c.charAt(0).toUpperCase() + c.slice(1)); ch.type = 'button';\n          ch.onclick = function () { caimento = c; Array.prototype.forEach.call(chips.children, function (x) { x.classList.remove('on'); }); ch.classList.add('on'); };\n          chips.appendChild(ch);\n        });\n        f.appendChild(chips);\n      }\n      var ok = el('button', 'enviar', 'Descobrir meu tamanho'); ok.type = 'button';\n      ok.onclick = function () {\n        if (crianca) { if (!idade.value) return; enviar('Idade da criança para a ' + p0.nome + ': ' + idade.value + ' anos'); }\n        else { if (!alt.value || !peso.value) return; enviar('Minhas medidas para a ' + p0.nome + ': altura ' + alt.value + ' cm, peso ' + peso.value + ' kg, caimento ' + caimento); }\n        ok.disabled = true;\n      };\n      f.appendChild(ok); box.appendChild(f);\n    } else if (b.tipo === 'comparacao') {\n      if (b.texto) box.appendChild(el('div', 'legenda', formatar(b.texto)));\n      var comp = el('div', 'comp'); var cols = el('div', 'cols');\n      var rotulos = { material: 'Material', gola: 'Gola', escudo: 'Escudo', manga: 'Manga' };\n      (b.produtos || []).forEach(function (p) {\n        var c = el('div', 'col'); var u = urlSegura(p.imagem);\n        var html = (u ? '<img alt=\"' + esc(p.nome) + '\" src=\"' + esc(u) + '\">' : '') + '<div class=\"nome\">' + esc(p.nome) + '</div>' +\n          '<div class=\"lin\"><b>Preço</b>' + brl(p.preco) + (p.preco_pix ? ' · Pix ' + brl(p.preco_pix) : '') + '</div>' +\n          '<div class=\"lin\"><b>Tamanhos</b>' + esc((p.tamanhos || []).join(', ') || '—') + '</div>';\n        Object.keys(rotulos).forEach(function (k) {\n          var v = (p.atributos || {})[k];\n          if (v) html += '<div class=\"lin\"><b>' + rotulos[k] + '</b>' + esc(String(v).replace(/^[^:]{0,20}:\\s*/, '')) + '</div>';\n        });\n        c.innerHTML = html; cols.appendChild(c);\n      });\n      comp.appendChild(cols); box.appendChild(comp);\n      box.appendChild(botoesAcao((b.produtos || []).map(function (p) { return { titulo: 'Quero ' + p.nome.split(' - ')[0] }; }), function (x) { enviar(x.titulo); }));\n    } else if (b.tipo === 'provador') {\n      box.appendChild(el('div', 'm lia', formatar((b.texto ? b.texto + '\\n' : '') + '📸 No WhatsApp, aqui chega a prévia de você vestindo a ' + (b.produto || {}).nome + '.')));\n    } else if (b.tipo === 'catalogo') {\n      box.appendChild(el('div', 'm lia', formatar(b.corpo)));\n      box.appendChild(botoesAcao([{ titulo: 'Ver catálogo' }], function () { enviar('Quero ver o catálogo completo'); }));\n    } else if (b.tipo === 'pagamento') {\n      var u2 = urlSegura(b.url);\n      box.appendChild(el('div', 'm lia', formatar(b.texto) + (u2 ? '<br><a class=\"pagar\" href=\"' + esc(u2) + '\" target=\"_blank\" rel=\"noopener\">Pagar agora</a>' : '')));\n    } else {\n      return null;\n    }\n    return box;\n  }\n\n  function mostrar(m) {\n    if (m.de === 'lia' && m.blocos && m.blocos.length) {\n      m.blocos.forEach(function (b) { var d = desenharBloco(b); if (d) caixa.appendChild(d); });\n    } else {\n      caixa.appendChild(el('div', 'm ' + (m.de === 'eu' ? 'eu' : 'lia'), formatar(m.texto)));\n    }\n    rolar();\n  }\n  function adicionar(m) { estado.msgs.push(m); guardar.gravar('olden_chat', estado); mostrar(m); }\n  estado.msgs.forEach(mostrar);\n\n  function enviar(texto) {\n    texto = String(texto || '').trim();\n    if (!texto || botao.disabled) return;\n    adicionar({ de: 'eu', texto: texto });\n    botao.disabled = true; digitando.textContent = 'Lia está digitando...';\n    fetch('olden-chat-enviar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sessao: estado.sessao, mensagem: texto }) })\n      .then(function (r) { return r.json(); })\n      .then(function (j) { adicionar({ de: 'lia', texto: j.resposta || 'Desculpa, tive um probleminha aqui. Pode repetir?', blocos: j.blocos || [] }); })\n      .catch(function () { adicionar({ de: 'lia', texto: 'Desculpa, tive um probleminha aqui. Pode repetir?' }); })\n      .then(function () { botao.disabled = false; digitando.textContent = ''; input.focus(); });\n  }\n  form.addEventListener('submit', function (ev) { ev.preventDefault(); var t = input.value; input.value = ''; enviar(t); });\n\n  // Mensagens que a Lia manda por iniciativa própria (pagamento aprovado, rastreio)\n  function buscarNovas() {\n    fetch('olden-chat-novas?s=' + encodeURIComponent(estado.sessao) + '&depois=' + estado.ultimo)\n      .then(function (r) { return r.json(); })\n      .then(function (j) {\n        (j.mensagens || []).forEach(function (m) {\n          if (m.id > estado.ultimo) { estado.ultimo = m.id; adicionar({ de: 'lia', texto: m.texto }); }\n        });\n      })\n      .catch(function () {});\n  }\n  setInterval(buscarNovas, 3000); buscarNovas();\n\n  document.getElementById('nova').addEventListener('click', function () {\n    estado = { sessao: novoId(), ultimo: 0, msgs: [{ de: 'lia', texto: BOAS_VINDAS }] };\n    guardar.gravar('olden_chat', estado);\n    caixa.innerHTML = ''; estado.msgs.forEach(mostrar); input.focus();\n  });\n})();\n</script>\n</body>\n</html>\n",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
