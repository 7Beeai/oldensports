      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce(jsonb_agg(jsonb_build_object('id', id, 'texto', texto) order by id), '[]'::jsonb) as mensagens\nfrom mensagens_saida\nwhere sessao = $1::jsonb->>'sessao' and id > ($1::jsonb->>'depois')::bigint",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ sessao: 'demo:' + String($json.query.s || '').replace(/[^a-zA-Z0-9-]/g, '').slice(0, 64), depois: String(parseInt($json.query.depois, 10) || 0) }) }}"
