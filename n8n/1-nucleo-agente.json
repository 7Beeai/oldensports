{
  "name": "Olden | 1. Núcleo do agente",
  "nodes": [
    {
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Entrada",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Configuração",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-0",
              "name": "sessao",
              "type": "string",
              "value": "={{ $json.sessao || 'teste:manual' }}"
            },
            {
              "id": "cfg-1",
              "name": "mensagem",
              "type": "string",
              "value": "={{ ($json.origem === 'sistema' ? $json.mensagem : String($json.mensagem || '').replace(/\\[\\s*AVISO INTERNO\\s*\\]/gi, '').trim()) || 'Oi, quero conhecer as camisas' }}"
            },
            {
              "id": "cfg-2",
              "name": "modelo",
              "type": "string",
              "value": "={{ $json.modelo || 'anthropic/claude-haiku-5.5' }}"
            },
            {
              "id": "cfg-3",
              "name": "esforco",
              "type": "string",
              "value": "={{ $json.esforco || 'medium' }}"
            },
            {
              "id": "cfg-4",
              "name": "janela",
              "type": "number",
              "value": "={{ Number($json.janela) || 20 }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Comando de teste?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        330,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cmd-0",
              "leftValue": "={{ $json.sessao.startsWith('teste:') && $json.mensagem.startsWith('#pagamento_') }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Simular pagamento",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        -200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select $1::jsonb->>'sessao' as sessao,\n       simular_pagamento_sessao($1::jsonb->>'sessao', $1::jsonb->>'mensagem') as mensagem,\n       $1::jsonb->>'modelo' as modelo, $1::jsonb->>'esforco' as esforco, ($1::jsonb->>'janela')::int as janela",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json) }}"
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Contexto do atendimento",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select c.*, prompt_montado(c.cliente_nome, c.status, c.situacao_pedido, c.catalogo) as prompt_sistema,\n       $1::jsonb->>'mensagem' as mensagem, $1::jsonb->>'modelo' as modelo,\n       $1::jsonb->>'esforco' as esforco, ($1::jsonb->>'janela')::int as janela\nfrom contexto_atendimento($1::jsonb->>'sessao') c",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json) }}"
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Agente Olden",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.mensagem }}",
        "options": {
          "systemMessage": "={{ $json.prompt_sistema }}",
          "maxIterations": 8
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Claude via OpenRouter",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        440,
        260
      ],
      "parameters": {
        "model": "={{ $json.modelo }}",
        "options": {
          "reasoningEffort": "={{ $json.esforco }}",
          "maxRetries": 2,
          "timeout": 90000
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Memória da conversa",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [
        620,
        260
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.conversa_id }}",
        "tableName": "n8n_chat_histories",
        "contextWindowLength": "={{ $json.janela }}"
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "registrar_interesse",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        780,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Registra que o cliente demonstrou interesse num produto. Chame quando o cliente perguntar sobre um produto específico do catálogo.",
        "operation": "executeQuery",
        "query": "insert into interesses (conversa_id, sku)\nselect (j->>'conversa_id')::uuid, j->>'sku'\nfrom (select $1::jsonb as j) p\nreturning 'interesse registrado' as resultado, sku;",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ conversa_id: $json.conversa_id, sku: $fromAI('sku', 'SKU do produto exatamente como no catálogo, ex.: CEL-BR', 'string') }) }}"
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000010",
      "name": "registrar_pedido",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        940,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Registra (reserva) um item do pedido e baixa o estoque. Só chame depois que o cliente confirmar produto, tamanho, quantidade, forma de pagamento e nome. Chame uma vez por produto/tamanho. O banco calcula o valor; se faltar estoque, devolve erro.",
        "operation": "executeQuery",
        "query": "insert into pedidos (conversa_id, sku, tamanho, quantidade, forma_pagamento, nome_cliente)\nselect (j->>'conversa_id')::uuid, j->>'sku', j->>'tamanho', (j->>'quantidade')::int,\n       j->>'forma_pagamento', j->>'nome_cliente'\nfrom (select $1::jsonb as j) p\nreturning sku, tamanho, quantidade, forma_pagamento, valor_unitario, valor_total, status;",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ conversa_id: $json.conversa_id, sku: $fromAI('sku', 'SKU do produto exatamente como no catálogo', 'string'), tamanho: $fromAI('tamanho', 'Tamanho exatamente como no catálogo, ex.: M, GG, 8, ÚNICO, 9 MESES', 'string'), quantidade: $fromAI('quantidade', 'Quantidade de peças, de 1 a 10', 'number'), forma_pagamento: $fromAI('forma_pagamento', 'pix ou cartao', 'string'), nome_cliente: $fromAI('nome_cliente', 'Nome do cliente', 'string') }) }}"
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000011",
      "name": "registrar_avaliacao",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        1100,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Registra a avaliação do atendimento (nota de 1 a 5 e comentário opcional) e encerra a conversa. Chame quando o cliente der a nota.",
        "operation": "executeQuery",
        "query": "insert into avaliacoes (conversa_id, nota, comentario)\nselect (j->>'conversa_id')::uuid, (j->>'nota')::int, nullif(j->>'comentario', '')\nfrom (select $1::jsonb as j) p\nreturning 'avaliacao registrada' as resultado, nota;",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ conversa_id: $json.conversa_id, nota: $fromAI('nota', 'Nota de 1 a 5 dada pelo cliente', 'number'), comentario: $fromAI('comentario', 'Comentário do cliente; vazio se não houver', 'string') }) }}"
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000012",
      "name": "gerar_link_pagamento",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        1260,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Gera o link de pagamento de todos os itens já registrados nesta conversa e devolve o link e o valor total. Chame depois de registrar o(s) item(ns) com registrar_pedido, ou quando o cliente precisar de um novo link (ex.: pagamento recusado). Envie ao cliente exatamente o link devolvido.",
        "operation": "executeQuery",
        "query": "select gerar_pagamento(($1::jsonb->>'conversa_id')::uuid) as resultado",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ conversa_id: $json.conversa_id }) }}"
        }
      }
    }
  ],
